-- themed card frame (gradient fill + outline)
local function cardFrame(parent, x, y, w, h)
    local card = make("Frame", {
        Size             = UDim2.fromOffset(w, h);
        Position         = UDim2.fromOffset(x, y);
        BackgroundColor3 = WHITE;
        BorderSizePixel  = 0;
    }, parent);
    corner(card, 12);
    bind(card, "BackgroundTransparency", "cardT");
    themedGradient(card, { "cardA", "cardB" }, 90);
    local st = stroke(card, cur.line, 1);
    bind(st, "Color", "line");
    return card;
end;

local function makeCard(parent, x, y, w, h, title, sub)
    local card = cardFrame(parent, x, y, w, h);

    local t = make("TextLabel", {
        Size                   = UDim2.fromOffset(w - 24, 18);
        Position               = UDim2.fromOffset(12, 10);
        BackgroundTransparency = 1;
        Text                   = title;
        TextColor3             = WHITE;
        Font                   = Enum.Font.GothamBold;
        TextSize               = 14;
        TextXAlignment         = Enum.TextXAlignment.Left;
    }, card);
    themedGradient(t, { "titleA", "titleB" }, 0);

    local s = make("TextLabel", {
        Size                   = UDim2.fromOffset(w - 24, 14);
        Position               = UDim2.fromOffset(12, 28);
        BackgroundTransparency = 1;
        Text                   = sub;
        Font                   = Enum.Font.Gotham;
        TextSize               = 10;
        TextXAlignment         = Enum.TextXAlignment.Left;
    }, card);
    bind(s, "TextColor3", "dim");

    local body = make("Frame", {
        Size                   = UDim2.fromOffset(w - 20, h - 60);
        Position               = UDim2.fromOffset(10, 50);
        BackgroundTransparency = 1;
        BorderSizePixel        = 0;
    }, card);
    local lay = Instance.new("UIListLayout");
    lay.Padding   = UDim.new(0, 6);
    lay.SortOrder = Enum.SortOrder.LayoutOrder;
    lay.Parent    = body;
    return card, body;
end;

local function makeRow(body, order)
    local row = make("Frame", {
        Size            = UDim2.new(1, 0, 0, 30);
        BorderSizePixel = 0;
        LayoutOrder     = order;
    }, body);
    corner(row, 8);
    bind(row, "BackgroundColor3", "row");
    return row;
end;

local function makeRowLabel(row, text, widthMinus)
    local l = make("TextLabel", {
        Size                   = UDim2.new(1, -widthMinus, 1, 0);
        Position               = UDim2.fromOffset(10, 0);
        BackgroundTransparency = 1;
        Text                   = text;
        Font                   = Enum.Font.GothamMedium;
        TextSize               = 12;
        TextXAlignment         = Enum.TextXAlignment.Left;
        TextTruncate           = Enum.TextTruncate.AtEnd;
    }, row);
    bind(l, "TextColor3", "ink");
    return l;
end;

-- toggle row bound to a boolean Config key
local function makeToggle(body, order, label, cfgKey)
    local row = makeRow(body, order);
    makeRowLabel(row, label, 60);

    local track = make("Frame", {
        Size             = UDim2.fromOffset(34, 18);
        Position         = UDim2.new(1, -44, 0.5, -9);
        BackgroundColor3 = WHITE;
        BorderSizePixel  = 0;
    }, row);
    corner(track, 9);
    local knob = make("Frame", {
        Size             = UDim2.fromOffset(14, 14);
        Position         = UDim2.fromOffset(2, 2);
        BackgroundColor3 = WHITE;
        BorderSizePixel  = 0;
    }, track);
    corner(knob, 7);

    local function paint()
        track.BackgroundColor3 = Config[cfgKey] and cur.accent or cur.swOff;
    end;
    paint();
    knob.Position = Config[cfgKey] and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2);
    table.insert(refreshers, paint);

    local btn = make("TextButton", {
        Size = UDim2.fromScale(1, 1); BackgroundTransparency = 1; Text = "";
    }, row);
    btn.MouseButton1Click:Connect(function()
        Config[cfgKey] = not Config[cfgKey];
        paint();
        TweenService:Create(knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
            Position = Config[cfgKey] and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)
        }):Play();
    end);
end;

-- label + numeric textbox row bound to a number Config key
local boxes = {};
local function makeSettingRow(body, order, labelTxt, cfgKey)
    local row = makeRow(body, order);
    local lbl = makeRowLabel(row, labelTxt, 76);

    local box = make("TextBox", {
        Size                   = UDim2.fromOffset(60, 22);
        Position               = UDim2.new(1, -68, 0.5, -11);
        BorderSizePixel        = 0;
        Text                   = tostring(Config[cfgKey]);
        Font                   = Enum.Font.GothamBold;
        TextSize               = 12;
        TextXAlignment         = Enum.TextXAlignment.Center;
        ClearTextOnFocus       = false;
    }, row);
    corner(box, 6);
    bind(box, "BackgroundColor3", "input");
    bind(box, "TextColor3", "inputTxt");
    local st = stroke(box, cur.line, 1);
    bind(st, "Color", "line");

    box.Focused:Connect(function() st.Color = BLUE end);
    box.FocusLost:Connect(function()
        st.Color = cur.line;
        local n = tonumber(box.Text);
        if n then Config[cfgKey] = n else box.Text = tostring(Config[cfgKey]) end;
    end);

    boxes[cfgKey] = box;
    return lbl;
end;

