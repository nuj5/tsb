-- ── controller: 1) teleport behind  2) smooth strafe behind  3) move loop ──
-- Nothing below runs until Rage Mode is switched on; switching it off disconnects everything.
local function releaseRage()
    local char = lp.Character;
    local hum  = char and char:FindFirstChildOfClass("Humanoid");
    if hum then hum.AutoRotate = true end;
    rageState.held       = false;
    rageState.teleported = false;
    rageState.target     = nil;
end;

local rageConn, rageGen = nil, 0;

local function rageStep(dt)
    if not isCurrent() then stopRage(); return end;
    dt = math.clamp(dt, 0, 0.1);

    local tgt = selectedPlayer;
    if not (RageCfg.Enabled and tgt) then
        if rageState.held then releaseRage() end;
        return;
    end;

    local tChar = tgt.Character;
    if not tChar then return end;                       -- target respawning / not loaded yet
    if not isAlive(tChar) then unselectPlayer(true); return end;

    local myChar = lp.Character;
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart");
    local myHum  = myChar and myChar:FindFirstChildOfClass("Humanoid");
    local tRoot  = tChar:FindFirstChild("HumanoidRootPart");
    if not myRoot or not myHum or myHum.Health <= 0 or not tRoot then return end;

    local tp      = tRoot.Position;
    local desired = behindPosition(tRoot.CFrame, RageCfg.Behind);
    if desired.X ~= desired.X or desired.Y ~= desired.Y or desired.Z ~= desired.Z then return end;

    myHum.AutoRotate = false;
    rageState.held   = true;

    -- step 1: teleport behind (also after our own respawn or a target switch)
    if not rageState.teleported or rageState.target ~= tgt or rageState.root ~= myRoot then
        rageState.target     = tgt;
        rageState.root       = myRoot;
        rageState.teleported = true;
        myRoot.CFrame = CFrame.lookAt(desired, Vector3.new(tp.X, desired.Y, tp.Z));
        myRoot.AssemblyLinearVelocity  = Vector3.zero;
        myRoot.AssemblyAngularVelocity = Vector3.zero;
        return;
    end;

    -- step 2: smooth strafe — frame-rate independent exponential follow, no re-teleporting
    local alpha  = 1 - math.exp(-dt * RageCfg.Smooth);
    local newPos = myRoot.Position:Lerp(desired, alpha);
    local face   = Vector3.new(tp.X - newPos.X, 0, tp.Z - newPos.Z);
    if face.Magnitude > 0.05 then
        myRoot.CFrame = CFrame.lookAt(newPos, newPos + face);
    else
        myRoot.CFrame = CFrame.new(newPos) * myRoot.CFrame.Rotation;
    end;
    myRoot.AssemblyLinearVelocity  = Vector3.zero;
    myRoot.AssemblyAngularVelocity = Vector3.zero;
end;

stopRage = function()
    rageGen += 1;
    if rageConn then rageConn:Disconnect(); rageConn = nil end;
    releaseRage();
end;

startRage = function()
    if rageConn then return end;
    rageGen += 1;
    local gen = rageGen;
    rageConn = RunService.RenderStepped:Connect(rageStep);

    -- step 3: move loop (only runs once the teleport has happened for the current target)
    task.spawn(function()
        while isCurrent() and gen == rageGen do
            local tgt = selectedPlayer;
            if RageCfg.Enabled and tgt and rageState.teleported and rageState.target == tgt then
                for _, m in ipairs(MOVE_ORDER) do
                    if not (isCurrent() and gen == rageGen and RageCfg.Enabled and selectedPlayer == tgt) then break end;
                    if RageCfg.Moves[m.key] then
                        runMove(m);
                        task.wait(RageCfg.MoveGap);
                    end;
                end;
                task.wait();
            else
                task.wait(0.05);
            end;
        end;
    end);
end;

