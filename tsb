-- pure: point `studs` behind a CFrame, on the flat plane, at the CFrame's own height
local function behindPosition(targetCF, studs)
    local look = targetCF.LookVector;
    local flat = Vector3.new(look.X, 0, look.Z);
    if flat.Magnitude < 1e-3 then flat = Vector3.new(0, 0, -1) end;
    return targetCF.Position - flat.Unit * studs;
end;

local function isAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid");
    return hum ~= nil and hum.Health > 0;
end;

-- ── remote calls (arguments copied from the captured calls) ──
local function getComm()
    local char = lp.Character;
    return char and char:FindFirstChild("Communicate");
end;

local function findTool(name)
    local bp = lp:FindFirstChild("Backpack");
    return (bp and bp:FindFirstChild(name)) or (lp.Character and lp.Character:FindFirstChild(name));
end;

local function aimCFrame()
    local cam = workspace.CurrentCamera;
    return cam and cam.CFrame or CFrame.new();
end;

local function fireHit()
    local ev = getComm();
    if not ev then return end;
    pcall(function()
        ev:FireServer({ MousePos = aimCFrame(); Goal = "LeftClick"; Tick = 1 });
        ev:FireServer({ Goal = "LeftClickRelease"; Tick = 1 });
    end);
end;

local function fireConsoleMove(toolName)
    local ev   = getComm();
    local tool = findTool(toolName);
    if not ev or not tool then return end;
    pcall(function()
        ev:FireServer({ IsAutoActivate = true; Goal = "Console Move"; Tool = tool; ToolName = toolName });
    end);
end;

local function fireRageDash()
    local ev = getComm();
    if not ev then return end;
    pcall(function()
        ev:FireServer({ Key = Enum.KeyCode.Q; MousePos = aimCFrame(); Dash = Enum.KeyCode.W; Goal = "KeyPress"; Tick = 1 });
    end);
end;

local function fireSideDash()
    local ev = getComm();
    if not ev then return end;
    pcall(function()
        ev:FireServer({ Key = Enum.KeyCode.Q; MousePos = aimCFrame(); Dash = Enum.KeyCode.D; Goal = "KeyPress"; Tick = 1 });
    end);
end;

local function runMove(m)
    if m.key == "Hit" then
        fireHit();
    elseif m.key == "Dash" then
        fireRageDash();
    elseif m.key == "SideDash" then
        fireSideDash();
    else
        fireConsoleMove(m.tool);
    end;
end;

